{
  "name": "chess-goat",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "TEST_UNIT_ONLY=1 vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm --filter @chess-goat/miniapp build",
    "dev:server": "pnpm --filter @chess-goat/server dev",
    "dev:app": "pnpm --filter @chess-goat/miniapp dev",
    "e2e": "pnpm --filter @chess-goat/miniapp e2e",
    "check:budget": "node scripts/check-bundle-size.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
